(text "HWID code = {HWID_3,HWID_2,HWID_1,HWID_0}; populated 0R = 1, DNP = 0\n0x0 no module / unprogrammed\n0x1 potentiometers (this population)\n0x2 mechanical keypad (populate R for HWID_1 only)\n0x3-0x6 reserved: encoders, sliders, LCD, LED ring\n0xF reserved\nDraft allocation - to be confirmed against the TRT module table" (exclude_from_sim no) (at 30 100 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "db3b3c29-e7fe-5277-b3f5-a3e3b6ad38f8"))
